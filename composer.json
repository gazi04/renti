{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "gazi04/rent-car-saas",
    "type": "project",
    "description": "Renti — multi-tenant, white-label car-rental SaaS for the Kosovo / Western Balkans market.",
    "keywords": ["laravel", "saas", "multi-tenant", "car-rental"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "barryvdh/laravel-dompdf": "^3.1",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "laravel/ai": "^1.0.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.7",
        "laravel/pulse": "^1.7",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "livewire/blaze": "^1.0",
        "livewire/flux": "^2.13.1",
        "livewire/livewire": "^4.1",
        "resend/resend-laravel": "^1.4",
        "saade/filament-fullcalendar": "^4.0@beta",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-medialibrary": "^11.23",
        "stancl/tenancy": "^3.10",
        "stechstudio/filament-impersonate": "^5.5"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "*",
        "dompdf/dompdf": "^3.1.6",
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.24",
        "icanhazstring/composer-unused": "*",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.2",
        "laravel/doctor": "^0.1.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-mutate": "^4.0",
        "pestphp/pest-plugin-type-coverage": "*",
        "phpstan/phpstan-strict-rules": "*",
        "rector/rector": "^2.5",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --host=0.0.0.0\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "types:baseline": [
            "phpstan analyse --generate-baseline"
        ],
        "refactor": [
            "rector"
        ],
        "refactor:check": [
            "rector --dry-run"
        ],
        "test:type-coverage": [
            "pest --type-coverage --min=100"
        ],
        "test:mutation": [
            "pest --mutate --parallel --testsuite=Unit,Feature --covered-only --min=78"
        ],
        "test:browser": [
            "pest --parallel --testsuite=Browser"
        ],
        "deps:unused": [
            "composer-unused"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@test:type-coverage",
            "@php artisan test --testsuite=Unit,Feature,Arch"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "clear": [
            "@php artisan cache:clear",
            "@php artisan config:clear",
            "@php artisan optimize:clear",
            "@php artisan view:clear",
            "@php artisan route:clear"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
