APP_NAME="Renti"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=rentacar_db
# DB_USERNAME=rentacar_user
# DB_PASSWORD=secret

# Tenancy hosts (override in production with real domains)
ADMIN_PANEL_DOMAIN=admin.localhost
TENANT_BASE_DOMAIN=localhost
CENTRAL_DOMAIN=localhost

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Scope the session cookie to the PARENT domain (leading dot) so it is shared
# across the admin panel (admin.<domain>) and every tenant subdomain. Required
# for operator impersonation to survive the redirect from admin. to the tenant
# subdomain. In production set e.g. SESSION_DOMAIN=.yourdomain.com.
# NOTE: a leading-dot ".localhost" cookie is rejected by browsers — for local
# cross-subdomain testing use a resolvable base domain such as .lvh.me.
# The admin "Log in as operator" (impersonation) action is HIDDEN while this is
# unset, since the session cannot carry across subdomains without it.
SESSION_DOMAIN=null

# Session + remember-me cookies are marked Secure automatically outside the
# local/testing environments (see config/session.php). Set this to false ONLY
# for an environment deliberately served over plain HTTP -- on HTTPS, leaving
# it unset is correct and leaving it false makes the parent-domain session
# cookie interceptable on every tenant subdomain.
# SESSION_SECURE_COOKIE=true

# HSTS max-age in seconds, sent on HTTPS responses only (config/security.php).
# Defaults to 86400 (1 day) so a misconfiguration ages out fast. Raise to
# 31536000 (1 year) once verified in production; 0 disables the header.
# HSTS_MAX_AGE=86400

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=database

# Must be a TAGGABLE store. CacheTenancyBootstrapper (config/tenancy.php) scopes
# every cache key with a per-tenant tag; Illuminate\Cache\DatabaseStore does not
# extend TaggableStore, so `database` breaks tenant cache isolation outright.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Days of email delivery-log rows to keep; older ones are pruned daily.
MAIL_LOG_RETENTION_DAYS=90

# Days of admin audit-log rows to keep; older ones are pruned daily.
ACTIVITYLOG_RETENTION_DAYS=365

# Days an abandoned signup (pending/cancelled, never used) is kept before the
# daily sweep deletes it and frees its subdomain for re-registration.
TENANT_ABANDONED_AFTER_DAYS=30

# Resend transport (set MAIL_MAILER=resend to use). RESEND_WEBHOOK_SECRET is the
# Svix signing secret (whsec_...) from the Resend webhook dashboard, used to
# verify inbound delivery webhooks that update the email delivery log.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Error monitoring. Leave the DSN blank locally and in CI — the SDK is a complete
# no-op without it, so nothing phones home from a dev machine or a test run.
# Sampling: 1.0 captures every error; traces are sampled at 10% because performance
# spans are a volume/cost tradeoff, errors are not.
# Do NOT set SENTRY_SEND_DEFAULT_PII=true — see the PII note in config/sentry.php.
SENTRY_LARAVEL_DSN=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# Application performance monitoring (slow queries, slow jobs, queue depth,
# exceptions). PULSE_DOMAIN defaults to ADMIN_PANEL_DOMAIN and must never be
# blank: tenant routes carry no domain constraint, so an unpinned /pulse would
# resolve on every operator subdomain. See config/pulse.php.
# In production also switch PULSE_INGEST_DRIVER=redis and run `pulse:work`,
# so Pulse stops writing synchronously to the Postgres instance that already
# backs cache, queue and sessions. The Servers card additionally needs a
# long-running `pulse:check` daemon under supervisor — without it that one card
# stays empty forever; see the Servers recorder note in config/pulse.php.
PULSE_ENABLED=true
PULSE_DOMAIN="${ADMIN_PANEL_DOMAIN}"
PULSE_INGEST_DRIVER=storage

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# GitHub Models (OpenAI-compatible). Token = a GitHub PAT with the models scope.
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1

# Load-balancer host handling. Both default off; see config/security.php and
# docs/deploy-runbook.md. FORWARDED_HOST_RECOVERY resolves tenants from a
# X-Forwarded-Host validated against the domains table, and exists so a load
# balancer that rewrites Host is an env change rather than an outage.
# HOST_DIAGNOSTICS_ENABLED exposes GET /_diagnostics/host for the first-deploy
# check; turn it back off afterwards.
# FORWARDED_HOST_RECOVERY=false
# HOST_DIAGNOSTICS_ENABLED=false
